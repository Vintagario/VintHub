-- Multi-select dropdown with "Select All" / "Clear All" as the first two entries
local SELECT_ALL, CLEAR_ALL = "★ Select All", "✖ Clear All"
local dropdownValues = { SELECT_ALL, CLEAR_ALL }
for _, n in ipairs(ITEM_NAMES) do table.insert(dropdownValues, n) end
local applyingItems = false
local itemDropdown

itemDropdown = Tab:Dropdown({
	Title = "Items",
	Desc = "Pick one or more",
	Values = dropdownValues,
	Value = selectedList(),
	Multi = true,
	AllowNone = true,
	Callback = function(chosen)
		if building or applyingItems then return end

		local picked = {}
		if type(chosen) == "table" then
			for k, v in pairs(chosen) do
				if type(v) == "string" then
					picked[v] = true
				elseif v == true and type(k) == "string" then
					picked[k] = true
				end
			end
		elseif type(chosen) == "string" then
			picked[chosen] = true
		end

		if picked[SELECT_ALL] or picked[CLEAR_ALL] then
			table.clear(state.items)
			if picked[SELECT_ALL] then
				for _, n in ipairs(ITEM_NAMES) do state.items[n] = true end
			end
			saveSettings()
			applyingItems = true
			pcall(function() itemDropdown:Select(selectedList()) end)
			applyingItems = false
			return
		end

		table.clear(state.items)
		for n in pairs(picked) do state.items[n] = true end
		saveSettings()
	end,
})

