-- greys out a control while another feature owns it (its on/off choice is kept)
local function setLocked(element, locked)
	pcall(function()
		if not element then return end
		if locked and element.Lock then
			element:Lock()
		elseif not locked and element.Unlock then
			element:Unlock()
		end
	end)
end

