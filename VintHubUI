local alive = true
local connections, extras = {}, {}
local function track(conn)
	table.insert(connections, conn)
	return conn
end

env.VintHubCleanup = function()
	alive = false
	for _, c in ipairs(connections) do
		pcall(function() c:Disconnect() end)
	end
	for _, f in ipairs(extras) do
		pcall(f)
	end
end
