-- SETTINGS (saved to a file; needs readfile/writefile from your executor)
---------------------------------------------------------------------
local SAVE_FILE = "VintHubTemplate.json"

local state = {
	items = {},          -- multi-select dropdown, [name] = true
	autoMain = false,    -- example toggle on Main
	autoReward = true,   -- example toggle on Rewards
	webhookUrl = "",
	webhookAlerts = true,
}

local ITEM_NAMES = { "ItemA", "ItemB", "ItemC" } -- TODO: build this from the game (e.g. a folder's children)

local function loadSettings()
	if not (isfile and readfile) then return end
	local ok, data = pcall(function()
		if isfile(SAVE_FILE) then
			return HttpService:JSONDecode(readfile(SAVE_FILE))
		end
	end)
	if ok and type(data) == "table" then
		if type(data.items) == "table" then
			for _, name in ipairs(data.items) do
				if table.find(ITEM_NAMES, name) then state.items[name] = true end
			end
		end
		state.autoMain = data.autoMain == true
		state.autoReward = data.autoReward ~= false -- on by default
		if type(data.webhookUrl) == "string" then state.webhookUrl = data.webhookUrl end
		state.webhookAlerts = data.webhookAlerts ~= false
	end
end

local function saveSettings()
	if not writefile then return end
	local items = {}
	for name in pairs(state.items) do table.insert(items, name) end
	pcall(function()
		writefile(SAVE_FILE, HttpService:JSONEncode({
			items = items,
			autoMain = state.autoMain,
			autoReward = state.autoReward,
			webhookUrl = state.webhookUrl,
			webhookAlerts = state.webhookAlerts,
		}))
	end)
end

loadSettings()

