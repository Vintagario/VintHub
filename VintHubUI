-- blue gradient theme: tries gradients, then a solid blue theme, then plain Dark
local function registerTheme()
	local function hex(h) return Color3.fromHex(h) end
	local base = {
		Name = "VintBlue",
		Accent = hex("#2563eb"),
		Dialog = hex("#0b1530"),
		Outline = hex("#3b82f6"),
		Text = hex("#e8f1ff"),
		Placeholder = hex("#7f93b8"),
		Background = hex("#0a1228"),
		Button = hex("#1e3a8a"),
		Icon = hex("#93c5fd"),
	}

	local okGradient = pcall(function()
		local theme = table.clone(base)
		theme.Accent = WindUI:Gradient({
			["0"] = { Color = hex("#1d4ed8"), Transparency = 0 },
			["100"] = { Color = hex("#38bdf8"), Transparency = 0 },
		}, { Rotation = 45 })
		theme.Background = WindUI:Gradient({
			["0"] = { Color = hex("#050b1f"), Transparency = 0 },
			["100"] = { Color = hex("#0f2a5c"), Transparency = 0 },
		}, { Rotation = 45 })
		WindUI:AddTheme(theme)
	end)
	if okGradient then return "VintBlue" end

	local okSolid = pcall(function() WindUI:AddTheme(base) end)
	return okSolid and "VintBlue" or "Dark"
end

local themeName = registerTheme()

