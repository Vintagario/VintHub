		setStatus(autoThrow and "Auto Throw on: roll/collect paused" or "Auto Throw off")
	end,
})

collectToggle = Tab:Toggle({
	Title = "Auto Collect",
	Desc = "Walks to your collect pad every " .. COLLECT_INTERVAL .. "s",
	Value = autoCollect,
	Callback = function(state)
		if building then return end
		autoCollect = state
		lastCollect = 0
		saveSettings()
		if autoThrow and state then
			setStatus("Collect will resume when Auto Throw is off")
		end
	end,
})

spinToggle = Tab:Toggle({
	Title = "Auto Spin Wheel",
	Desc = "Spins the wheel and skips the animation (no walking)",
	Value = autoSpin,
	Callback = function(state)
		if building then return end
		if state and not Remotes then
			autoSpin = false
			pcall(function() spinToggle:Set(false) end)
			notify("Auto Spin", "Couldn't find the wheel remotes")
			return
		end
		autoSpin = state
		saveSettings()
	end,
})

local statusPara = Tab:Paragraph({
	Title = "Status",
	Desc = "Idle",
})

statusSetter = function(text)
	pcall(function() statusPara:SetDesc(text) end)
end

applyModes()

-- open on the Main tab
pcall(function() Tab:Select() end)
pcall(function() Window:SelectTab(1) end)

building = false
notify("VintHub", "Loaded")
