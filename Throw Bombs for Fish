		pcall(function() FishCfg = require(cfg:WaitForChild("Fish", 5)) end)
		pcall(function() InvCfg = require(cfg:WaitForChild("Inventory", 5)) end)
		pcall(function() TankCfg = require(cfg:WaitForChild("Tank", 5)) end)
	end
end

local onFarmChanged = nil -- set by the UI so it can refresh toggle locks
