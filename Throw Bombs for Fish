local ThrowCfg, Timing, bestTier
do
	local ok, cfg = pcall(function()
		return require(ReplicatedStorage:WaitForChild("Config"):WaitForChild("Throw"))
	end)
	if ok and type(cfg) == "table" and cfg.Timing then
		ThrowCfg = cfg
		Timing = cfg.Timing
		for _, tier in pairs(Timing.Tiers) do
			if not bestTier or tier.Start > bestTier.Start then
				bestTier = tier
			end
		end
	else
		warn("AutoThrow: couldn't load Config.Throw, auto throw disabled")
	end
end

local function getTimingParts()
	local frames = playerGui:FindFirstChild("Frames")
	local gui = frames and frames:FindFirstChild(Timing.Gui)
	if not (gui and gui:IsA("GuiObject") and gui.Visible) then return end
	local timer = gui:FindFirstChild(Timing.Timer)
	local arrow = timer and (Timing.Arrow == Timing.Timer and timer or timer:FindFirstChild(Timing.Arrow))
	local button = gui:FindFirstChild(Timing.Button)
	if arrow and arrow:IsA("GuiObject") and button and button:IsA("GuiButton") then
		return arrow, button
	end
end

local function pressButton(button)
	if firesignal then
		firesignal(button.Activated)
		return true
	elseif getconnections then
		for _, c in ipairs(getconnections(button.Activated)) do c:Fire() end
		return true
	end
	return false
end

local lastThrow = 0
local armed = false
local lastFullMsg = 0

-- Inventory.Fish vs Inventory.MaxFish (same numbers the game's inventory window shows)
-- returns fish count, max (nil if the data can't be read)
local function fishCount()
	if not DataCtl then return nil end
	local ok, inv = pcall(DataCtl.Get, "Inventory")
	if ok and type(inv) == "table" and type(inv.Fish) == "table" then
		return #inv.Fish, tonumber(inv.MaxFish)
	end
	return nil
end

-- buffer = how many slots before max still counts as "full" (0 = completely full)
local function fishInventoryFull(buffer)
	local n, max = fishCount()
	return n ~= nil and max ~= nil and n >= max - (buffer or 0)
end

-- The arrow runs 0 -> 1 -> 0 every 2 * Timing.Sweep seconds and Perfect is fill >= bestTier.Start
-- (0.98), so the window is only a few ms either side of the peak. Waiting for the arrow to enter it
-- fails on low FPS (a frame can skip the whole window), so this presses on the frame closest to the
-- predicted peak, then reads the result and nudges the timing (throwLead) if it wasn't Perfect.
local throwLead = 0      -- seconds to press before the predicted peak (auto-tuned, negative = later)
local leadDir, missStreak = 1, 0
local throwHits, throwMisses = 0, 0
local dtAvg = 1 / 60
local prevFill = nil

local function reportThrow(gui)
	task.delay(0.2, function()
		if not alive then return end
		local label = gui and gui:FindFirstChild(Timing.Flash, true)
		if not (label and label:IsA("TextLabel")) then return end
		local text = label.Text:upper()
		if text == "" then return end

		if bestTier.Text and text:find(bestTier.Text:upper(), 1, true) then
			throwHits += 1
			missStreak = 0
		else
			throwMisses += 1
			missStreak += 1
			if missStreak > 3 then -- this direction isn't helping, try the other one
				leadDir = -leadDir
				missStreak = 1
			end
			throwLead = math.clamp(throwLead + leadDir * 0.003, -0.02, 0.04)
		end
		setStatus(("Throw: %s (perfect %d/%d, lead %dms)"):format(
			text, throwHits, throwHits + throwMisses, math.floor(throwLead * 1000 + 0.5)))
	end)
end

local throwConn = RunService.RenderStepped:Connect(function(dt)
	dtAvg = dtAvg * 0.9 + math.min(dt, 0.1) * 0.1

	if not throwActive() or not ThrowCfg or not bestTier then
		armed = false
		prevFill = nil
		return
	end

	local arrow, button = getTimingParts()
	if not arrow then
		armed = false
		prevFill = nil
		return
	end

	if os.clock() - lastThrow < 0.5 then
		prevFill = nil
		return
	end

	local fill = arrow.Position.X.Scale
	local last = prevFill
	prevFill = fill

	local tier = ThrowCfg.TimingTier(fill)
	if tier and tier.Name ~= bestTier.Name then
		armed = true -- a live reading below Perfect, so this is a fresh sweep
	end
	if not armed or not last then return end

	local press
	if fill > last then
		-- rising: press when the next frame would overshoot the peak more than this one undershoots
		local toPeak = (1 - fill) / (1 / Timing.Sweep)
		press = fill >= 0.8 and toPeak <= dtAvg / 2 + throwLead
	else
		-- just past the peak: still inside the window
		press = fill >= bestTier.Start
	end
	if not press then return end

	if fishInventoryFull() then
		if os.clock() - lastFullMsg > 3 then
			lastFullMsg = os.clock()
			setStatus("Fish inventory full: throwing paused")
		end
		return
	end

	if pressButton(button) then
		armed = false
		prevFill = nil
		lastThrow = os.clock()
		reportThrow(button.Parent)
	end
end)
table.insert(connections, throwConn)

