-- AUTO COLLECT CASH (stands on your tank's collect pad)
---------------------------------------------------------------------
local claimName, plateName = "Claim", "CollectPlate"
do
	local ok, cfg = pcall(function()
		return require(ReplicatedStorage:WaitForChild("Config"):WaitForChild("Tank"))
	end)
	if ok and type(cfg) == "table" then
		if cfg.ClaimName then claimName = cfg.ClaimName end
		if type(cfg.CollectPlate) == "table" and cfg.CollectPlate.Name then
			plateName = cfg.CollectPlate.Name
		end
	end
end

local function getCollectPart()
	local plot = player:GetAttribute("PlotNumber")
	local map = Workspace:FindFirstChild("Map")
	local tanks = map and map:FindFirstChild("FishTanks")
	local tank = plot and tanks and tanks:FindFirstChild("FishTank" .. plot)
	local pads = tank and tank:FindFirstChild("Pads")
	if not pads then return nil end

	local part = pads:FindFirstChild(claimName)
	if part and part:IsA("BasePart") then return part end

	local collect = pads:FindFirstChild("Collect")
	part = collect and collect:FindFirstChild(plateName)
	if part and part:IsA("BasePart") then return part end
	return nil
end

local function collectCash()
	local part = getCollectPart()
	if not part then
		setStatus("Collect pad not found")
		return false
	end

	local char = player.Character
	local humanoid = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not (humanoid and root) then return false end

	setStatus("Collecting cash...")

	local flatTol = math.clamp(math.min(part.Size.X, part.Size.Z) / 4, 2, 6)
	local function flatDist()
		local d = root.Position - part.Position
		return Vector3.new(d.X, 0, d.Z).Magnitude
	end

	local step = newMover()
	local deadline = os.clock() + 20
	while collecting and not throwActive() and os.clock() < deadline and flatDist() > flatTol do
		step(humanoid, root, part.Position)
		task.wait(0.1)
	end

	if throwActive() then
		humanoid:MoveTo(root.Position)
		return false
	end

	if flatDist() > flatTol + 2 then
		humanoid:MoveTo(root.Position)
		setStatus("Couldn't reach collect pad")
		return false
	end

	if firetouchinterest then
		pcall(function()
			firetouchinterest(root, part, 0)
			firetouchinterest(root, part, 1)
		end)
	end

	task.wait(COLLECT_STAND_TIME)
	setStatus("Collected cash")
	return true
end

local lastCollect = 0

task.spawn(function()
	while alive do
		-- collect when the player wants it, or while Auto Farm is in its roll phase;
		-- always suspended while throwing
		local wantCollect = (autoCollect or autoFarm) and not throwActive()
		if wantCollect and os.clock() - lastCollect >= COLLECT_INTERVAL then
			lock()
			-- state may have changed while we waited for the lock
			if (autoCollect or autoFarm) and not throwActive() then
				collecting = true
				pcall(collectCash)
				collecting = false
			end
			unlock()
			lastCollect = os.clock()
		end
		task.wait(1)
	end
end)

