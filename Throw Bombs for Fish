---------------------------------------------------------------------
-- WALKING (goes near the target if out of reach)
---------------------------------------------------------------------
local running = false   -- effective state (rollWanted and not autoThrow)
local rollWanted = false -- what the player toggled
local collecting = false

-- Returns a step function you call every ~0.1s. It walks toward `target`,
-- jumps when something blocks the way, and sidesteps if still stuck.
local function newMover()
	local state = { lastPos = nil, lastCheck = 0, stuck = 0, side = 1 }

	return function(humanoid, root, target)
		humanoid:MoveTo(target)

		local flat = Vector3.new(target.X - root.Position.X, 0, target.Z - root.Position.Z)
		if flat.Magnitude < 0.1 then return end
		local dir = flat.Unit
		local grounded = humanoid.FloorMaterial ~= Enum.Material.Air

		-- 1) Something solid straight ahead at knee height -> jump
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { humanoid.Parent }
		local hit = Workspace:Raycast(root.Position - Vector3.new(0, 1.5, 0), dir * 3.5, params)
		if hit and hit.Instance.CanCollide and grounded then
			humanoid.Jump = true
		end

		-- 2) Not making progress -> jump, and if still stuck, sidestep around it
		local now = os.clock()
		if not state.lastPos then
			state.lastPos, state.lastCheck = root.Position, now
		end
		if now - state.lastCheck >= 0.4 then
			if (root.Position - state.lastPos).Magnitude < 0.5 then
				state.stuck += 1
				if grounded then humanoid.Jump = true end
				if state.stuck >= 3 then
					local right = dir:Cross(Vector3.yAxis)
					humanoid:MoveTo(root.Position + right * state.side * 8)
					state.side = -state.side
					state.stuck = 0
					task.wait(0.6)
				end
			else
				state.stuck = 0
			end
			state.lastPos, state.lastCheck = root.Position, now
		end
	end
end

local function walkNear(pos, range)
	local char = player.Character
	local humanoid = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not (humanoid and root) then return false end

	range = range or 10
	if (root.Position - pos).Magnitude <= range - 1 then
		return true -- already close enough
	end

	local stopDist = math.max(range * 0.6, 3)
	local step = newMover()
	local deadline = os.clock() + 20
	while (running or collecting) and os.clock() < deadline do
		if (root.Position - pos).Magnitude <= stopDist then break end
		step(humanoid, root, pos)
		task.wait(0.1)
	end
	humanoid:MoveTo(root.Position) -- stop moving
	task.wait(0.1)

	return (root.Position - pos).Magnitude <= range
end

local function promptPosition(prompt)
	local p = prompt.Parent
	if p and p:IsA("Attachment") then return p.WorldPosition end
	if p and p:IsA("BasePart") then return p.Position end
	return nil
end

