local function getRoot()
	local char = player.Character
	return char and char:FindFirstChild("HumanoidRootPart")
end

local function flatDistance(a, b)
	return Vector3.new(a.X - b.X, 0, a.Z - b.Z).Magnitude
end

-- walks to a point on the XZ plane; returns true when within tol
local function walkFlat(target, tol, timeout)
	local char = player.Character
	local humanoid = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not (humanoid and root) then return false end

	local step = newMover()
	local deadline = os.clock() + timeout
	while autoFarm and os.clock() < deadline and humanoid.Health > 0 and root.Parent
		and flatDistance(root.Position, target) > tol do
		step(humanoid, root, Vector3.new(target.X, root.Position.Y, target.Z))
		task.wait(0.1)
	end
	humanoid:MoveTo(root.Position)
	task.wait(0.1)
	return root.Parent ~= nil and flatDistance(root.Position, target) <= tol + 2
end

-- centre of the nearest Island's Lookout > 23262B part
local function findLookoutSpot()
	local map = Workspace:FindFirstChild("Map")
	local islands = map and map:FindFirstChild("Islands")
	local root = getRoot()
	if not (islands and root) then return nil end

	local bestPos, bestDist
	for _, island in ipairs(islands:GetChildren()) do
		local lookout = island:FindFirstChild("Lookout")
		local part = lookout and lookout:FindFirstChild("23262B", true)
		local pos = part and getPosition(part)
		if pos then
			local d = flatDistance(pos, root.Position)
			if not bestDist or d < bestDist then
				bestPos, bestDist = pos, d
			end
		end
	end
	return bestPos
end

-- the game's own check: is this position inside a throw deck?
local function inThrowZone()
	local root = getRoot()
	if not root then return false end
	if BombCfg and BombCfg.NearestDeck and BombCfg.DeckDistance then
		local ok, dist = pcall(function()
			return BombCfg.DeckDistance(root.Position, BombCfg.NearestDeck(root.Position))
		end)
		if ok and type(dist) == "number" then
			return dist <= 0.01
		end
	end
	return true -- no config to check against; trust the lookout position
end

local farmSpot = nil -- where we decided to stand for throwing

local function goToThrowSpot()
	local spot = findLookoutSpot()
	if spot then
		walkFlat(spot, FARM_SPOT_TOL, 45)
		farmSpot = spot
	end

	-- if the lookout centre is outside the game's throw zone, aim for the middle of the zone instead
	if not inThrowZone() and BombCfg and BombCfg.NearestDeck then
		local root = getRoot()
		if root then
			local deck = BombCfg.NearestDeck(root.Position)
			local mid = ((BombCfg.ThrowZoneFrom or 0) + (BombCfg.DeckHalfLength or 12)) / 2
			local target = deck.Center + deck.Out * mid
			walkFlat(target, 3, 25)
			farmSpot = target
		end
	end

	local root = getRoot()
	return farmSpot ~= nil and root ~= nil and flatDistance(root.Position, farmSpot) <= FARM_SPOT_TOL + 3
end

-- fish the tank would be better off with are never sold
local function isFavoriteFish(inv, id)
	if not InvCfg then return true end -- can't check: treat as protected
	local fav = type(inv) == "table" and inv.Favorites
	return type(fav) == "table" and fav[InvCfg.FishKey(id)] == true
end

local function planSales()
	if not (DataCtl and FishCfg and InvCfg and TankCfg and TankCfg.Income) then return nil end
	local okI, inv = pcall(DataCtl.Get, "Inventory")
	local okT, tank = pcall(DataCtl.Get, "Tank")
	if not (okI and okT and type(inv) == "table" and type(tank) == "table") then return nil end

	local tankFish = type(tank.Fish) == "table" and tank.Fish or {}
	local free = math.max((tonumber(tank.Capacity) or #tankFish) - #tankFish, 0)

	local weakest = math.huge
	for _, f in ipairs(tankFish) do
		local ok, inc = pcall(TankCfg.Income, f.Species, f.Weight, f.Mutation, tankFish)
		if ok and type(inc) == "number" and inc < weakest then
			weakest = inc
		end
	end

	local cands = {}
	for _, f in ipairs(type(inv.Fish) == "table" and inv.Fish or {}) do
		if FishCfg.ById[f.Species] and not isFavoriteFish(inv, f.Id) then
			local ok, inc = pcall(TankCfg.Income, f.Species, f.Weight, f.Mutation, tankFish)
			-- unknown income counts as "very good" so it is kept
			table.insert(cands, {
				id = f.Id,
				income = (ok and type(inc) == "number") and inc or math.huge,
			})
		end
	end

	table.sort(cands, function(a, b)
		if a.income ~= b.income then return a.income > b.income end
		return tostring(a.id) < tostring(b.id)
	end)

	local sell, kept = {}, 0
	for i, c in ipairs(cands) do
		-- keep what fills free tank slots, and anything stronger than the weakest tank fish
		local keep = i <= free or c.income > weakest
		if keep then
			kept += 1
		else
			table.insert(sell, c.id)
		end
	end
	return sell, kept
end

local UpgradesCfg
do
	local cfg = ReplicatedStorage:FindFirstChild("Config")
	if cfg then
		pcall(function() UpgradesCfg = require(cfg:WaitForChild("Upgrades", 5)) end)
	end
end

-- the zone part inside a shop (name from Config.Upgrades.Shops.ZoneName, else any part with "zone" in its name)
local function shopZonePart(shop)
	local name = UpgradesCfg and UpgradesCfg.Shops and UpgradesCfg.Shops.ZoneName
	local z = name and shop:FindFirstChild(name, true)
	if z and z:IsA("BasePart") then return z end
	for _, d in ipairs(shop:GetDescendants()) do
		if d:IsA("BasePart") and d.Name:lower():find("zone") then
			return d
		end
	end
	return nil
end

-- nearest fish market: Workspace.Map.Shops.FishMarket1..6 (or any shop with Kind == "Sell").
-- Returns the position to stand at and how close counts as "there".
local function findSellSpot()
	local map = Workspace:FindFirstChild("Map")
	local folder = map and (map:FindFirstChild("Shops")
		or (UpgradesCfg and UpgradesCfg.Shops and map:FindFirstChild(UpgradesCfg.Shops.FolderPath)))
	local root = getRoot()
	if not (folder and root) then return nil end

	local bestPos, bestTol, bestDist
	for _, shop in ipairs(folder:GetChildren()) do
		if shop.Name:match("^FishMarket%d+$") or shop:GetAttribute("Kind") == "Sell" then
			local zone = shopZonePart(shop)
			local pos = zone and zone.Position or getPosition(shop)
			if pos then
				local tol = zone and math.clamp(math.min(zone.Size.X, zone.Size.Z) / 4, 2, 6) or 6
				local d = flatDistance(pos, root.Position)
				if not bestDist or d < bestDist then
					bestPos, bestTol, bestDist = pos, tol, d
				end
			end
		end
	end
	return bestPos, bestTol
end

local function sendSells(ids)
	local sellRemote = Remotes.get("SellFish")
	local sold = 0
	for _, id in ipairs(ids) do
		if not autoFarm then break end
		sellRemote:FireServer(id)
		sold += 1
		task.wait(0.15)
	end
	return sold
end

-- the server may only accept sales while you stand in the shop zone
local function sellAtShop()
	local spot, tol = findSellSpot()
	if not spot then
		setStatus("Farm: sell shop not found")
		warn("[VintHub] sell shop not found (Workspace.Map.Shops.FishMarketN)")
		return
	end

	setStatus("Farm: walking to the fish market")
	if not walkFlat(spot, tol, 45) then
		setStatus("Farm: couldn't reach the sell shop")
		return
	end
	task.wait(0.6) -- let the server see us inside the zone

	local ids = planSales()
	if not ids or #ids == 0 then return end
	local before = fishCount() or #ids
	local sold = sendSells(ids)
	task.wait(1)
	local after = fishCount() or before
	setStatus(("Farm: sold at the shop (%d sent, %d -> %d fish)"):format(sold, before, after))
end

local remoteSellWorks = nil -- nil = not tried yet, then true/false

local function farmSellCycle()
	if not Remotes then return end
	local tankRemote = Remotes.get("Tank")

	-- safety check: equip the best fish first. If something that belongs in the
	-- tank is still in the inventory afterwards, try once more.
	local ids, kept
	for _ = 1, 2 do
		tankRemote:FireServer("EquipBest")
		task.wait(1.2) -- let the server move the fish and the client data update
		ids, kept = planSales()
		if not ids or kept == 0 then break end
	end

	if not ids then
		setStatus("Farm: couldn't read inventory")
		return
	end
	if #ids == 0 then
		setStatus("Farm: inventory nearly full but nothing sellable (favorites/tank fish only)")
		return
	end

	-- 1) try selling from wherever we are
	if remoteSellWorks ~= false then
		local before = fishCount() or #ids
		local sold = sendSells(ids)
		task.wait(1)
		local after = fishCount() or before
		if after < before then
			remoteSellWorks = true
			setStatus(("Farm: sold %d fish remotely (%d -> %d)"):format(sold, before, after))
			return
		end
		remoteSellWorks = false
		print("[VintHub] remote sell had no effect, selling at the shop instead")
	end

	-- 2) walk into the sell shop and sell there
	-- (in the throw phase the loop walks us back to the lookout afterwards)
	lock()
	local ok, err = pcall(sellAtShop)
	unlock()
	if not ok then
		warn("[VintHub] shop sell error: " .. tostring(err))
	end
end

-- no timer: it only runs when the fish inventory is within FISH_SELL_BUFFER slots of max
local lastSell = 0
local lastReadWarn = 0
task.spawn(function()
	while alive do
		task.wait(0.5)
		if autoFarm and os.clock() - lastSell >= 10 then
			local n, max = fishCount()
			if not n or not max then
				if os.clock() - lastReadWarn > 30 then
					lastReadWarn = os.clock()
					warn("[VintHub] can't read the fish inventory (DataController / Inventory.MaxFish)")
					setStatus("Farm: can't read fish inventory")
				end
			elseif n >= max - FISH_SELL_BUFFER then
				local msg = ("Farm: fish %d/%d, equip best + sell"):format(n, max)
				print("[VintHub] " .. msg)
				setStatus(msg)
				local ok, err = pcall(farmSellCycle)
				if not ok then
					warn("[VintHub] sell cycle error: " .. tostring(err))
				end
				lastSell = os.clock() -- also the retry cooldown if nothing could be sold
			end
		end
	end
end)

local function enterThrowPhase()
	lock() -- waits for any roll/collect step to finish
	if autoFarm and farmPhase == "roll" then
		farmPhase = "throw"
		farmSpot = nil
		farmChanged()
		setStatus("Farm: " .. MAX_HELD .. " bombs, heading to the lookout")
		pcall(goToThrowSpot)
		if not (farmSpot and getRoot() and flatDistance(getRoot().Position, farmSpot) <= FARM_SPOT_TOL + 3) then
			setStatus("Farm: couldn't reach the throw spot, retrying")
		end
	end
	unlock()
end

task.spawn(function()
	local zeroChecks = 0
	while alive do
		task.wait(0.5)

		if not autoFarm then
			if farmPhase ~= "roll" then
				farmPhase = "roll"
				farmChanged()
			end
			zeroChecks = 0
		elseif farmPhase == "roll" then
			zeroChecks = 0
			if heldBombs() >= MAX_HELD then
				enterThrowPhase()
			end
		else
			local held = heldBombs()
			if held <= 0 then zeroChecks += 1 else zeroChecks = 0 end

			if zeroChecks >= 4 and os.clock() - lastThrow > 2 then
				-- out of bombs: back to rolling + collecting, and sell what the throws gave us
				zeroChecks = 0
				farmPhase = "roll"
				lastCollect = 0
				lastSell = 0
				farmChanged()
				setStatus("Farm: out of bombs, back to rolling")
			else
				local root = getRoot()
				local away = root and (not farmSpot or flatDistance(root.Position, farmSpot) > FARM_SPOT_TOL + 6)
				if held > 0 and away then
					lock()
					if autoFarm and farmPhase == "throw" then
						pcall(goToThrowSpot)
					end
					unlock()
				end
			end
		end
	end
end)

