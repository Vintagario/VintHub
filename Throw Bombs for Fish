local function getCost(offer)
	local prompt = offer:FindFirstChildWhichIsA("ProximityPrompt", true)
	if prompt and prompt.ActionText:find("%d") then
		local v = parseNumber(prompt.ActionText)
		if v then return v end
	end

	for _, key in ipairs({ "Cost", "Price" }) do
		local attr = offer:GetAttribute(key)
		if attr then return parseNumber(attr) end
	end
	for _, d in ipairs(offer:GetDescendants()) do
		local n = d.Name:lower()
		if d:IsA("ValueBase") and (n:find("cost") or n:find("price")) then
			return parseNumber(d.Value)
		end
	end
	for _, d in ipairs(offer:GetDescendants()) do
		if d:IsA("TextLabel") then
			local n = d.Name:lower()
			if n:find("cost") or n:find("price") or d.Text:find("%$") then
				local v = parseNumber(d.Text)
				if v then return v end
			end
		end
	end
	return nil
end

