local selected = {}   -- [name] = true
local autoThrow = false
local autoCollect = false
local status = nil    -- set after UI is built

local function loadSettings()
	if not (isfile and readfile) then return end
	local ok, data = pcall(function()
		if isfile(SAVE_FILE) then
			return HttpService:JSONDecode(readfile(SAVE_FILE))
		end
	end)
	if ok and type(data) == "table" then
		if type(data.items) == "table" then
			for _, name in ipairs(data.items) do
				if table.find(ITEM_NAMES, name) then
					selected[name] = true
				end
			end
		end
		autoThrow = data.autoThrow == true
		autoCollect = data.autoCollect == true
	end
end

local function saveSettings()
	if not writefile then return end
	local items = {}
	for name in pairs(selected) do table.insert(items, name) end
	pcall(function()
		writefile(SAVE_FILE, HttpService:JSONEncode({
			items = items,
			autoThrow = autoThrow,
			autoCollect = autoCollect,
		}))
	end)
end

