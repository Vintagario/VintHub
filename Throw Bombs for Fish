local ThrowCfg, Timing, bestTier
do
	local ok, cfg = pcall(function()
		return require(ReplicatedStorage:WaitForChild("Config"):WaitForChild("Throw"))
	end)
	if ok and type(cfg) == "table" and cfg.Timing then
		ThrowCfg = cfg
		Timing = cfg.Timing
		for _, tier in pairs(Timing.Tiers) do
			if not bestTier or tier.Start > bestTier.Start then
				bestTier = tier
			end
		end
	else
		warn("AutoThrow: couldn't load Config.Throw, auto throw disabled")
	end
end

local function getTimingParts()
	local frames = playerGui:FindFirstChild("Frames")
	local gui = frames and frames:FindFirstChild(Timing.Gui)
	if not (gui and gui:IsA("GuiObject") and gui.Visible) then return end
	local timer = gui:FindFirstChild(Timing.Timer)
	local arrow = timer and (Timing.Arrow == Timing.Timer and timer or timer:FindFirstChild(Timing.Arrow))
	local button = gui:FindFirstChild(Timing.Button)
	if arrow and arrow:IsA("GuiObject") and button and button:IsA("GuiButton") then
		return arrow, button
	end
end

local function pressButton(button)
	if firesignal then
		firesignal(button.Activated)
		return true
	elseif getconnections then
		for _, c in ipairs(getconnections(button.Activated)) do c:Fire() end
		return true
	end
	return false
end

local lastThrow = 0
local armed = false -- only true once we've seen a fresh, non-perfect arrow position

RunService.RenderStepped:Connect(function()
	if not autoThrow or not ThrowCfg or not bestTier then
		armed = false
		return
	end

	local arrow, button = getTimingParts()
	if not arrow then
		-- Throw UI is hidden (throwing, cutscene, not carrying): reset
		armed = false
		return
	end

	if os.clock() - lastThrow < 0.5 then return end

	local fill = arrow.Position.X.Scale
	local tier = ThrowCfg.TimingTier(fill)
	if not tier then return end

	if tier.Name ~= bestTier.Name then
		-- Arrow is somewhere below perfect, so this is a live reading. Arm.
		armed = true
		return
	end

	-- Arrow is in the perfect tier. Only press if we saw it climb there this round.
	if armed and pressButton(button) then
		armed = false
		lastThrow = os.clock()
		setStatus("Perfect throw: " .. tier.Name)
	end
end)

---------------------------------------------------------------------
-- AUTO EQUIP HIGHEST BOMB (while Auto Throw is ON)
---------------------------------------------------------------------
-- Rank = position in ITEM_NAMES (later = better). Matches tool names
-- ignoring case, spaces and underscores, so "Universe Reset Button x5" still matches.
local function bombRank(toolName)
	local lower = (toolName:lower():gsub("[%s_%-]", ""))
	local best, bestLen = nil, 0
	for i, n in ipairs(ITEM_NAMES) do
		local key = n:lower()
		-- "Shiny Plasma Bomb" -> "shinyplasmabomb" still contains "plasmabomb".
		-- Longest match wins, so a mutation word can't be mistaken for another bomb.
		if #key > bestLen and lower:find(key, 1, true) then
			best, bestLen = i, #key
		end
	end
	return best
end

local function bestOwnedTool()
	local char = player.Character
	local backpack = player:FindFirstChildOfClass("Backpack")
	local bestTool, bestRank
	for _, container in ipairs({ char, backpack }) do
		if container then
			for _, tool in ipairs(container:GetChildren()) do
				if tool:IsA("Tool") then
					local r = bombRank(tool.Name)
					if r and (not bestRank or r > bestRank) then
						bestTool, bestRank = tool, r
					end
				end
			end
		end
	end
	return bestTool, bestRank
end

task.spawn(function()
	while true do
		task.wait(0.5)
		-- skip during throw cutscenes (the game shows a "Letterbox" gui then)
		if autoThrow and ThrowCfg
			and not playerGui:FindFirstChild("Letterbox")
			and os.clock() - lastThrow > 2 then
			pcall(function()
				local char = player.Character
				local humanoid = char and char:FindFirstChildOfClass("Humanoid")
				if not humanoid or humanoid.Health <= 0 then return end

				local tool = bestOwnedTool()
				if tool and tool.Parent ~= char then
					humanoid:EquipTool(tool)
					setStatus("Equipped " .. tool.Name)
				end
			end)
		end
	end
end)

