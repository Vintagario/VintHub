local refreshCollectBtn -- defined below; the throw button needs to update it
local refreshRollBtn     -- same for the roll button

-- Auto throw button
local function refreshThrowBtn()
	throwBtn.Text = autoThrow and "Auto Throw: ON" or "Auto Throw: OFF"
	throwBtn.BackgroundColor3 = autoThrow and GREEN or RED
end
refreshThrowBtn()

throwBtn.MouseButton1Click:Connect(function()
	if not ThrowCfg then
		setStatus("Throw config not found")
		return
	end
	autoThrow = not autoThrow
	armed = false
	if not autoThrow then
		lastCollect = 0 -- if Auto Collect was on before, it resumes right away
	end
	refreshThrowBtn()
	refreshCollectBtn()
	refreshRollBtn()
	saveSettings()
	list.Visible = false
end)

-- Auto collect button
function refreshCollectBtn()
	if autoThrow then
		-- locked while Auto Throw is on; "PAUSED" means it was ON and will resume
		collectBtn.Text = autoCollect and "Collect: PAUSED" or "Collect: LOCKED"
		collectBtn.BackgroundColor3 = Color3.fromRGB(90, 90, 95)
	else
		collectBtn.Text = autoCollect and "Auto Collect: ON" or "Auto Collect: OFF"
		collectBtn.BackgroundColor3 = autoCollect and GREEN or RED
	end
end
refreshCollectBtn()

collectBtn.MouseButton1Click:Connect(function()
	if autoThrow then
		setStatus("Turn off Auto Throw to use Auto Collect")
		return
	end
	autoCollect = not autoCollect
	lastCollect = 0 -- collect right away when turned on
	refreshCollectBtn()
	saveSettings()
	list.Visible = false
end)

---------------------------------------------------------------------
-- MAIN LOOP (auto roll / buy)
---------------------------------------------------------------------
function refreshRollBtn()
	running = rollWanted and not autoThrow
	if autoThrow then
		-- locked while Auto Throw is on; "PAUSED" means it was ON and will resume
		toggleBtn.Text = rollWanted and "Roll: PAUSED" or "Roll: LOCKED"
		toggleBtn.BackgroundColor3 = Color3.fromRGB(90, 90, 95)
	else
		toggleBtn.Text = rollWanted and "Auto Roll: ON" or "Auto Roll: OFF"
		toggleBtn.BackgroundColor3 = rollWanted and GREEN or RED
	end
end
refreshRollBtn()

toggleBtn.MouseButton1Click:Connect(function()
	if autoThrow then
		setStatus("Turn off Auto Throw to use Auto Roll")
		return
	end
	rollWanted = not rollWanted
	refreshRollBtn()
	setStatus(running and "Running..." or "Idle")
	list.Visible = false
end)

local function rollIteration()
	local result, name = tryBuy()
	if result == "bought" then
		setStatus("Bought " .. name)
		return
	end

	if result == "expensive" then
		setStatus("Too expensive, rerolling")
	end

	if not roll() then
		setStatus("Can't reach/trigger lever")
		task.wait(2)
		return
	end

	task.wait(BUY_WINDOW)
	result, name = tryBuy()
	if result == "bought" then
		setStatus("Bought " .. name)
	elseif result == "expensive" then
		setStatus("Too expensive, skipped")
	else
		setStatus("Rolling...")
	end
end

task.spawn(function()
	while true do
		if running then
			if next(selected) == nil then
				setStatus("Select at least one item")
				task.wait(0.5)
			else
				lock()
				pcall(rollIteration)
				unlock()
				task.wait(ROLL_DELAY) -- lock is free here so collecting can slot in
			end
		else
			task.wait(0.25)
		end
	end
end)
