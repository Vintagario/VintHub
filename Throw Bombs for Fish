local BombCfg
pcall(function()
	BombCfg = require(ReplicatedStorage:WaitForChild("Config", 5):WaitForChild("Bombs", 5))
end)

local MAX_HELD = (BombCfg and tonumber(BombCfg.MaxHeld)) or 50

local function normName(s)
	return (s:lower():gsub("[%s_%-]", ""))
end

-- Every known bomb (id + display name) -> rank (higher = better).
-- Uses the game's own Config.Bombs when available, else the ITEM_NAMES list.
local bombKeys = {}
if BombCfg and type(BombCfg.All) == "table" then
	for _, b in ipairs(BombCfg.All) do
		local rank = (BombCfg.Rank and BombCfg.Rank(b.Id)) or 0
		table.insert(bombKeys, { key = normName(b.Id), rank = rank })
		if b.Name then
			table.insert(bombKeys, { key = normName(b.Name), rank = rank })
		end
	end
else
	for i, n in ipairs(ITEM_NAMES) do
		table.insert(bombKeys, { key = normName(n), rank = i })
	end
end

-- Matches tool names ignoring case, spaces and underscores, so
-- "Universe Reset Button x5" still matches. Longest match wins, so
-- "Sea Mine" is never mistaken for "Mine" and a mutation word can't confuse it.
local function bombRank(toolName)
	local lower = normName(toolName)
	local best, bestLen = nil, 0
	for _, e in ipairs(bombKeys) do
		if #e.key > bestLen and lower:find(e.key, 1, true) then
			best, bestLen = e.rank, #e.key
		end
	end
	return best
end

-- Stack size of a bomb tool: "Count" attribute, then a Count value child,
-- then an "x5" in the name, else 1.
local function toolCount(tool)
	local attr = tool:GetAttribute("Count")
	if type(attr) == "number" then return attr end
	local child = tool:FindFirstChild("Count")
	if child and child:IsA("ValueBase") then
		local n = tonumber(child.Value)
		if n then return n end
	end
	local n = tonumber(tool.Name:match("[xX]%s*(%d+)") or tool.Name:match("(%d+)%s*[xX]"))
	return n or 1
end

-- the game tags bomb tools with BombId (fish tools have ItemKey but no BombId)
local function toolBombRank(tool)
	local id = tool:GetAttribute("BombId")
	if id then
		local b = BombCfg and BombCfg.ById and BombCfg.ById[id]
		if b then
			return b.Tier * 1000 + ((BombCfg.Rank and BombCfg.Rank(id)) or 0)
		end
	elseif tool:GetAttribute("ItemKey") then
		return nil -- a fish
	end
	return bombRank(tool.Name)
end

local function ownedContainers()
	local list = {}
	if player.Character then table.insert(list, player.Character) end
	local backpack = player:FindFirstChildOfClass("Backpack")
	if backpack then table.insert(list, backpack) end
	return list
end

local function heldBombs()
	if DataCtl then
		local ok, bombs = pcall(DataCtl.Get, "Bombs")
		if ok and type(bombs) == "table" then
			local sum = 0
			for _, b in pairs(bombs) do
				sum += tonumber(b.Count) or 1
			end
			return sum
		end
	end
	local total = 0
	for _, container in ipairs(ownedContainers()) do
		for _, tool in ipairs(container:GetChildren()) do
			if tool:IsA("Tool") and toolBombRank(tool) ~= nil then
				total += toolCount(tool)
			end
		end
	end
	return total
end

local function bestOwnedTool()
	local bestTool, bestRank
	for _, container in ipairs(ownedContainers()) do
		for _, tool in ipairs(container:GetChildren()) do
			if tool:IsA("Tool") then
				local r = toolBombRank(tool)
				if r and (not bestRank or r > bestRank) then
					bestTool, bestRank = tool, r
				end
			end
		end
	end
	return bestTool, bestRank
end

