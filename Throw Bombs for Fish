local function rollIteration()
	local result, name = tryBuy()
	if result == "bought" then
		setStatus("Bought " .. name)
		return
	end

	if result == "expensive" then
		setStatus("Too expensive, rerolling")
	end

	if not roll() then
		setStatus("Can't reach/trigger lever")
		task.wait(2)
		return
	end

	task.wait(BUY_WINDOW)
	result, name = tryBuy()
	if result == "bought" then
		setStatus("Bought " .. name)
	elseif result == "expensive" then
		setStatus("Too expensive, skipped")
	else
		setStatus("Rolling...")
	end
end

task.spawn(function()
	while alive do
		if running then
			if next(selected) == nil then
				setStatus("Select at least one bomb")
				task.wait(0.5)
			else
				lock()
				if running then -- may have changed while waiting for the lock
					pcall(rollIteration)
				end
				unlock()
				task.wait(ROLL_DELAY)
			end
		else
			task.wait(0.25)
		end
	end
end)

