-- Returns: "bought", "expensive", or nil
local function tryBuy()
	local sawExpensive = false
	for name in pairs(selected) do
		local offer = offers:FindFirstChild(name)
		if offer then
			local cost = getCost(offer)
			local cash = getCash()
			if cost and cash and cost > cash then
				sawExpensive = true
			elseif interact(offer) then
				lastBuy = os.clock()
				local char = player.Character
				local hum = char and char:FindFirstChildOfClass("Humanoid")
				task.delay(0.3, function()
					if hum then hum:UnequipTools() end
				end)
				return "bought", name
			end
		end
	end
	return sawExpensive and "expensive" or nil
end

